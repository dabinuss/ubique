GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
UBIQUE_GEMINI_DAILY_LIMIT=20

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
UBIQUE_GROQ_DAILY_LIMIT=1000

HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_ENDPOINT=https://router.huggingface.co/hf-inference/models

GITHUB_TOKEN=
GITHUB_REPOSITORY=

UBIQUE_MAX_TASKS=3
UBIQUE_MEMORY_LIMIT=500
UBIQUE_DRY_RUN=0
UBIQUE_LOG_LEVEL=INFO

# Ubique v2 neurocognitive controls
UBIQUE_BRAIN_WORKSPACE_SLOTS=7
UBIQUE_BRAIN_MAX_SUBSTRATES=2
UBIQUE_BRAIN_MAX_IMMEDIATE_PULSES=3
UBIQUE_BRAIN_ACTIVATION_THRESHOLD=0.24
